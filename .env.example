# Скопируйте в .env и подставьте свои значения. Файл .env в Git не попадает.
# Никогда не помещайте сюда реальные пароли и ключи.

# Подключение к базе. На сервере — 127.0.0.1:5433, с ноутбука — через SSH-туннель:
#   ssh -f -N -L 5433:127.0.0.1:5433 vac-ru
DATABASE_URL=postgresql://football:ПАРОЛЬ@127.0.0.1:5433/football

# Ключ API-Football (dashboard.api-football.com)
APIFOOTBALL_KEY=ваш_ключ
